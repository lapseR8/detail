{
  "name": "detail",
  "version": "0.84.9",
  "description": "Detail — a weekly shift-scheduling product by Campaigner Studios. Draggable shift planner with screenshot export.",
  "main": "main.js",
  "author": "Campaigner Studios",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:arm": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.campaignerstudios.detail",
    "productName": "Detail",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "vendor/**/*",
      "build/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64"] }
      ],
      "icon": "build/icon.icns",
      "identity": null
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "build/icon-source.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "dmg": {
      "title": "Detail 0.84.9 — Campaigner Studios"
    }
  }
}
